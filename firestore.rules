rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: staff_records
    // Document ID: {recordId}
    // Fields:
    //   - id: string (required) - unique record ID
    //   - uid: string (required, immutable) - owner's user ID
    //   - name: string (required, size < 100)
    //   - degree: string (optional)
    //   - department: string (optional)
    //   - employer: string (optional)
    //   - weeklySchedule: list (required, size <= 7) - array of schedule objects
    //   - attendanceDates: list (required, size <= 100) - array of date strings
    //   - createdAt: timestamp (optional)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function isValidStaffRecord(data) {
      return data.keys().hasOnly(['id', 'uid', 'name', 'degree', 'department', 'employer', 'weeklySchedule', 'attendanceDates', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             (!('degree' in data) || data.degree is string) &&
             (!('department' in data) || data.department is string) &&
             (!('employer' in data) || data.employer is string) &&
             data.weeklySchedule is list && data.weeklySchedule.size() <= 7 &&
             data.attendanceDates is list && data.attendanceDates.size() <= 100;
    }

    match /staff_records/{recordId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if isAuthenticated() && 
                      hasRequiredFields(['id', 'uid', 'name', 'weeklySchedule', 'attendanceDates']) &&
                      isValidStaffRecord(request.resource.data) &&
                      request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && 
                      isDocOwner() &&
                      isValidStaffRecord(request.resource.data) &&
                      uidNotModified();
      allow delete: if isAuthenticated() && isDocOwner();
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}
